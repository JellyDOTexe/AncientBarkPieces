<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AncientBarkPieces</AssemblyName>
    <RootNamespace>AncientBarkPieces</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ValheimDir>$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
    <Managed>$(ValheimDir)/valheim_Data/Managed</Managed>
    <BepCore>$(ValheimDir)/BepInEx/core</BepCore>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="bark.png" LogicalName="bark.png" />
    <EmbeddedResource Include="roofslope.png" LogicalName="roofslope.png" />
    <EmbeddedResource Include="roofridge.png" LogicalName="roofridge.png" />
    <Reference Include="$(BepCore)/BepInEx.dll" Private="false" />
    <Reference Include="$(BepCore)/0Harmony.dll" Private="false" />
    <Reference Include="$(ValheimDir)/BepInEx/plugins/ValheimModding-Jotunn/Jotunn.dll" Private="false" />
    <Reference Include="$(Managed)/assembly_valheim.dll" Private="false" />
    <Reference Include="$(Managed)/assembly_utils.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.AssetBundleModule.dll" Private="false" />
  </ItemGroup>
</Project>
